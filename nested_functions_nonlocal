# practic 4

def make_counter(step):
    count = 0
    def by_two():
        nonlocal count
        count += step
        return count

    def by_ten():
        nonlocal count
        count += step
        return count
    return by_two if step == 2 else by_ten

by_two = make_counter(2)
by_ten = make_counter(10)

print(by_two(), by_two())
print(by_ten())
print(by_two())